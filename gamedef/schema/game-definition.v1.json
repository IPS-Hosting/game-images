{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IPS-Hosting/game-images/gamedef/schema/game-definition.v1.json",
  "title": "IPS Hosting game definition v1",
  "description": "Complete, product-independent definition of one game. Specification: gamedef/SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "short", "name", "run"],
  "properties": {
    "apiVersion": { "const": 1 },
    "short": { "type": "string", "pattern": "^[a-z0-9]{1,32}$" },
    "name": { "$ref": "#/$defs/i18n", "description": "Display name (de required)." },
    "description": { "$ref": "#/$defs/i18n", "description": "Factual game description. Omitted: filled from Steam when steamAppId is set." },
    "steamAppId": { "type": "integer", "minimum": 1, "description": "Store app id of the game (not the dedicated server)." },
    "image": { "type": ["string", "null"], "format": "uri", "description": "Logo/cover URL. Omitted or null: keep the platform image." },
    "tags": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/tag" } },
    "sources": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/source" } },
    "run": { "$ref": "#/$defs/run" },
    "install": {
      "type": "array",
      "maxItems": 16,
      "description": "Ordered install/update stages. Empty or omitted: the image installs itself.",
      "items": { "$ref": "#/$defs/installStage" }
    },
    "players": { "$ref": "#/$defs/players" },
    "query": { "$ref": "#/$defs/query" },
    "ports": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/port" } },
    "settings": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/setting" } },
    "config": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/configFile" } },
    "hooks": { "$ref": "#/$defs/hooks" },
    "protectedFiles": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/protectedFile" } },
    "backupIgnore": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/glob" } },
    "preconditions": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/precondition" } },
    "workshop": { "$ref": "#/$defs/workshop" },
    "flags": { "$ref": "#/$defs/flags" },
    "requirements": { "$ref": "#/$defs/requirements" }
  },
  "$defs": {
    "template": { "type": "string", "maxLength": 8192, "description": "Go text/template (SPEC §5.1)." },
    "literal": { "type": "string", "maxLength": 512, "pattern": "^[^\\x00]*$", "not": { "pattern": "\\{\\{" } },
    "i18n": {
      "description": "Localized text. A plain string is shorthand for { de: <string> }.",
      "oneOf": [
        { "type": "string", "maxLength": 4096, "pattern": "\\S" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["de"],
          "properties": {
            "de": { "type": "string", "maxLength": 4096, "pattern": "\\S" },
            "en": { "type": "string", "maxLength": 4096, "pattern": "\\S" }
          }
        }
      ]
    },
    "tag": {
      "enum": [
        "action", "adventure", "battle-royale", "building", "co-op", "crafting", "fps", "horror",
        "mmo", "moddable", "multiplayer", "open-world", "pvp", "pve", "racing", "roleplay",
        "rts", "sandbox", "simulation", "space", "sports", "strategy", "survival", "tactical",
        "voice", "zombies"
      ]
    },
    "category": {
      "enum": ["general", "network", "gameplay", "world", "admin", "mods", "steamBeta", "advanced", "performance"],
      "description": "Setting category id; labels in categories.v1.json."
    },
    "relativePath": {
      "allOf": [{ "$ref": "#/$defs/literal" }],
      "minLength": 1,
      "pattern": "^[^/]",
      "description": "Literal path relative to run.dataPath. Must not escape the data directory."
    },
    "templatePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/\\x00][^\\x00]*$",
      "description": "Path relative to run.dataPath, may be a template. Checked again after rendering."
    },
    "glob": { "allOf": [{ "$ref": "#/$defs/literal" }], "minLength": 1, "not": { "pattern": "\\.\\." } },
    "absolutePath": { "type": "string", "pattern": "^/[^\\x00]*$", "maxLength": 512 },
    "envMap": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
      "patternProperties": { "^(LD|DYLD)_": { "$ref": "#/$defs/template", "not": { "pattern": "\\{\\{" }, "description": "Loader variables must be literal." } },
      "additionalProperties": { "$ref": "#/$defs/template" }
    },
    "image": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9./:_@-]+$",
      "description": "Literal image reference: own images by tag, external images pinned by digest (SPEC §3.1)."
    },
    "settingKey": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,127}$" },
    "portIdentifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "regex": { "type": "string", "minLength": 1, "maxLength": 512, "description": "RE2 regular expression." },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["manual", "egg", "amp", "lgsm"] },
        "ref": { "type": "string", "maxLength": 512, "description": "Upstream file and commit, e.g. pelican-eggs/games-steamcmd@<sha>:valheim/egg-valheim.json." },
        "license": { "type": "string", "maxLength": 64, "description": "SPDX id of the upstream license (full text in THIRD_PARTY_NOTICES.md)." },
        "converter": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[0-9A-Za-z][0-9A-Za-z.+-]*$", "description": "Converter name@version." },
        "importedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "sha256 of the unedited converter output." }
      },
      "if": { "properties": { "kind": { "not": { "const": "manual" } } } },
      "then": { "required": ["ref", "license"] }
    },
    "condition": {
      "description": "Structured condition (SPEC §5.3). Exactly one operator.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "setting": { "$ref": "#/$defs/settingKey" },
        "equals": { "type": "string" },
        "notEquals": { "type": "string" },
        "in": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string" } },
        "truthy": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "matches": { "type": "string", "maxLength": 512 },
        "notContains": { "$ref": "#/$defs/settingKey" },
        "all": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/condition" } },
        "any": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/condition" } },
        "not": { "$ref": "#/$defs/condition" }
      },
      "oneOf": [
        { "required": ["setting", "equals"], "maxProperties": 2 },
        { "required": ["setting", "notEquals"], "maxProperties": 2 },
        { "required": ["setting", "in"], "maxProperties": 2 },
        { "required": ["setting", "truthy"], "maxProperties": 2 },
        { "required": ["setting", "minLength"], "maxProperties": 2 },
        { "required": ["setting", "maxLength"], "maxProperties": 2 },
        { "required": ["setting", "matches"], "maxProperties": 2 },
        { "required": ["setting", "notContains"], "maxProperties": 2 },
        { "required": ["all"], "maxProperties": 1 },
        { "required": ["any"], "maxProperties": 1 },
        { "required": ["not"], "maxProperties": 1 }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "imageVariants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setting", "images"],
          "properties": {
            "setting": { "$ref": "#/$defs/settingKey", "description": "STRINGENUM setting whose values equal the keys of images." },
            "images": { "type": "object", "minProperties": 1, "maxProperties": 32, "additionalProperties": { "$ref": "#/$defs/image" } }
          }
        },
        "dataPath": { "$ref": "#/$defs/absolutePath", "default": "/home/ips-hosting" },
        "workingDir": { "$ref": "#/$defs/relativePath" },
        "env": { "$ref": "#/$defs/envMap" },
        "machineId": { "type": "boolean", "default": false, "description": "Stable random /etc/machine-id (read-only)." },
        "tmpfs": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/absolutePath" } },
        "exec": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/argItem" } },
        "shell": { "type": "string", "minLength": 1, "maxLength": 16384, "description": "POSIX sh command line, run via sh -c. Not a template: values come in via env." },
        "console": { "$ref": "#/$defs/console" },
        "stop": { "$ref": "#/$defs/stop" },
        "ready": { "$ref": "#/$defs/ready" }
      },
      "oneOf": [{ "required": ["image"] }, { "required": ["imageVariants"] }],
      "not": { "required": ["exec", "shell"] }
    },
    "installStage": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["steamcmd", "download", "script"] } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "steamcmd" } } }, "then": { "$ref": "#/$defs/stageSteamcmd" } },
        { "if": { "properties": { "kind": { "const": "download" } } }, "then": { "$ref": "#/$defs/stageDownload" } },
        { "if": { "properties": { "kind": { "const": "script" } } }, "then": { "$ref": "#/$defs/stageScript" } }
      ]
    },
    "stageSteamcmd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "appId"],
      "properties": {
        "kind": true,
        "when": { "$ref": "#/$defs/condition" },
        "appId": { "type": "integer", "minimum": 1 },
        "login": { "enum": ["anonymous", "host"], "default": "anonymous" },
        "platform": { "enum": ["linux", "windows"], "description": "@sSteamCmdForcePlatformType" },
        "branch": { "$ref": "#/$defs/template", "description": "Fixed beta branch, empty = public." },
        "beta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branchSetting"],
          "properties": {
            "branchSetting": { "$ref": "#/$defs/settingKey", "description": "STRING or STRINGENUM; empty or public = no beta." },
            "passwordSetting": { "$ref": "#/$defs/settingKey", "description": "HIDDENSTRING." }
          }
        },
        "steamSdk": { "type": "boolean", "default": false, "description": "Link linux64/linux32 steamclient.so into ~/.steam/sdk64/sdk32 after the install." },
        "dir": { "$ref": "#/$defs/relativePath", "description": "Install directory relative to dataPath (default: dataPath)." },
        "extraArgs": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "pattern": "^[^{}\"\\r\\n\\x00]+$" } }
      },
      "not": { "required": ["branch", "beta"] }
    },
    "stageDownload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "checksum"],
      "properties": {
        "kind": true,
        "when": { "$ref": "#/$defs/condition" },
        "url": { "type": "string", "maxLength": 2048, "pattern": "^https://[^\\s{}]+$" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "dest": { "$ref": "#/$defs/relativePath", "description": "Target file (extract none) or directory." },
        "extract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["none", "zip", "tar", "tar.gz", "tar.xz"], "default": "none" },
            "stripComponents": { "type": "integer", "minimum": 0, "maximum": 8, "default": 0 }
          }
        }
      }
    },
    "stageScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "shell"],
      "properties": {
        "kind": true,
        "when": { "$ref": "#/$defs/condition" },
        "image": { "$ref": "#/$defs/image", "description": "Default: the platform installer image." },
        "shell": { "type": "string", "minLength": 1, "maxLength": 65536, "description": "POSIX sh script, run unprivileged with dataPath as working directory. Not a template: values come in via env." },
        "env": { "$ref": "#/$defs/envMap" }
      }
    },
    "argItem": {
      "oneOf": [
        { "$ref": "#/$defs/template" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg"],
          "properties": {
            "arg": { "$ref": "#/$defs/template", "minLength": 1 },
            "value": { "$ref": "#/$defs/template" },
            "when": { "$ref": "#/$defs/condition" }
          }
        }
      ]
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via": { "enum": ["stdin", "rcon", "none"], "default": "stdin" },
        "port": { "$ref": "#/$defs/portIdentifier" },
        "passwordSetting": { "$ref": "#/$defs/settingKey" }
      },
      "if": { "properties": { "via": { "const": "rcon" } }, "required": ["via"] },
      "then": { "required": ["port", "passwordSetting"] },
      "else": { "not": { "anyOf": [{ "required": ["port"] }, { "required": ["passwordSetting"] }] } }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "via": { "enum": ["signal", "command"], "default": "signal" },
        "signal": { "enum": ["SIGTERM", "SIGINT", "SIGQUIT", "SIGHUP", "SIGKILL"], "default": "SIGTERM" },
        "command": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Sent over the console channel (stdin or rcon)." },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600, "default": 10 }
      },
      "if": { "properties": { "via": { "const": "command" } }, "required": ["via"] },
      "then": { "required": ["command"] }
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": { "pattern": { "$ref": "#/$defs/regex", "description": "Marks the server as running when a console line matches." } }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "joinPattern": { "$ref": "#/$defs/regex", "description": "Optional named group 'name'." },
        "leavePattern": { "$ref": "#/$defs/regex" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol"],
      "properties": {
        "protocol": { "enum": ["a2s", "minecraft", "rcon", "http", "none"] },
        "port": { "$ref": "#/$defs/portIdentifier" },
        "fallbackPort": { "$ref": "#/$defs/portIdentifier" },
        "passwordSetting": { "$ref": "#/$defs/settingKey" },
        "command": { "type": "string", "minLength": 1, "maxLength": 256 },
        "pattern": { "$ref": "#/$defs/regex", "description": "Optional named groups name, map, players, maxPlayers." },
        "countLinesCommand": { "type": "string", "minLength": 1, "maxLength": 256 },
        "countLinesSkip": { "type": "integer", "minimum": 0, "maximum": 8, "default": 0 },
        "path": { "type": "string", "maxLength": 512, "pattern": "^/[^\\s#{}]*$", "description": "http: URL path; host is always the server's own IPv4." },
        "scheme": { "enum": ["http", "https"], "default": "http" },
        "insecure": { "type": "boolean", "default": false },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "map": { "type": "string", "minLength": 1 },
            "players": { "type": "string", "minLength": 1 },
            "maxPlayers": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "protocol": { "not": { "const": "none" } } } }, "then": { "required": ["port"] } },
        { "if": { "properties": { "protocol": { "const": "rcon" } } }, "then": { "required": ["passwordSetting"], "anyOf": [{ "required": ["command"] }, { "required": ["countLinesCommand"] }] } },
        { "if": { "properties": { "protocol": { "const": "http" } } }, "then": { "required": ["path"] } }
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "protocol", "default"],
      "properties": {
        "identifier": { "$ref": "#/$defs/portIdentifier" },
        "name": { "$ref": "#/$defs/i18n" },
        "protocol": { "enum": ["TCP", "UDP"] },
        "default": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "group": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0 },
        "static": { "type": "boolean", "default": false }
      }
    },
    "settingValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "maxLength": 256 },
        "label": { "$ref": "#/$defs/i18n" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "required": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "integer": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 512, "description": "RE2, must match the whole value." }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "type"],
      "properties": {
        "key": { "$ref": "#/$defs/settingKey" },
        "name": { "$ref": "#/$defs/i18n" },
        "description": { "$ref": "#/$defs/i18n" },
        "type": { "enum": ["STRING", "HIDDENSTRING", "MULTILINESTRING", "NUMBER", "BOOLEAN", "STRINGENUM", "NUMBERENUM", "STRINGLIST"] },
        "default": { "type": "string", "maxLength": 2048, "description": "String-encoded default. BOOLEAN: '0' or '1'. STRINGLIST: JSON array." },
        "validation": { "$ref": "#/$defs/validation" },
        "generate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length"],
          "properties": {
            "length": { "type": "integer", "minimum": 4, "maximum": 256 },
            "charset": { "enum": ["alnum", "hex"], "default": "alnum" }
          },
          "description": "The platform fills a random value at server creation when the value is empty. STRING/HIDDENSTRING only, no default."
        },
        "category": { "$ref": "#/$defs/category", "default": "general" },
        "values": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/settingValue" } },
        "valuesSource": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,63}$", "description": "Platform value source (e.g. minecraftVersions)." },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "userEditable": { "type": "boolean", "default": true }
      },
      "not": { "required": ["values", "valuesSource"] }
    },
    "configFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "format": { "enum": ["properties", "kv", "ini", "json", "yaml", "lines", "xml", "template"] },
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 256,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 256 },
          "additionalProperties": { "$ref": "#/$defs/template" }
        },
        "template": { "$ref": "#/$defs/template" },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 4, "description": "kv only, default '='." },
        "onlyIfExists": { "type": "boolean", "default": false, "description": "Skip the file when it does not exist (e.g. created by the game on first start)." },
        "createFrom": { "$ref": "#/$defs/relativePath", "description": "Copy this file to path when path does not exist, then apply the values." },
        "when": { "$ref": "#/$defs/condition" }
      },
      "allOf": [
        { "if": { "properties": { "format": { "const": "template" } } }, "then": { "required": ["template"], "not": { "required": ["values"] } }, "else": { "required": ["values"], "not": { "required": ["template"] } } },
        { "if": { "properties": { "format": { "not": { "const": "kv" } } } }, "then": { "not": { "required": ["delimiter"] } } }
      ]
    },
    "hookOp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/$defs/condition" },
        "copyIfMissing": {
          "type": "object", "additionalProperties": false, "required": ["from", "to"],
          "properties": { "from": { "$ref": "#/$defs/templatePath" }, "to": { "$ref": "#/$defs/templatePath" } }
        },
        "symlink": {
          "type": "object", "additionalProperties": false, "required": ["target", "link"],
          "properties": { "target": { "$ref": "#/$defs/templatePath" }, "link": { "$ref": "#/$defs/templatePath" } }
        },
        "replace": {
          "type": "object", "additionalProperties": false, "required": ["path", "pattern", "replacement"],
          "properties": {
            "path": { "$ref": "#/$defs/templatePath" },
            "pattern": { "$ref": "#/$defs/regex" },
            "replacement": { "$ref": "#/$defs/template" }
          }
        },
        "ensureDir": {
          "type": "object", "additionalProperties": false, "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/templatePath" } }
        },
        "writeFile": {
          "type": "object", "additionalProperties": false, "required": ["path", "content"],
          "properties": {
            "path": { "$ref": "#/$defs/templatePath" },
            "content": { "$ref": "#/$defs/template" },
            "mode": { "type": "string", "pattern": "^0[0-7]{3}$", "default": "0644" },
            "ifMissing": { "type": "boolean", "default": false, "description": "Write only when the file does not exist." }
          }
        }
      },
      "oneOf": [
        { "required": ["copyIfMissing"] },
        { "required": ["symlink"] },
        { "required": ["replace"] },
        { "required": ["ensureDir"] },
        { "required": ["writeFile"] }
      ]
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postInstall": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/hookOp" } },
        "preStart": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/hookOp" } }
      }
    },
    "protectedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/glob", "description": "Glob relative to the data directory (leading / allowed). Earlier entries take precedence." },
        "readOnly": { "type": "boolean" },
        "hidden": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["readOnly"], "properties": { "readOnly": { "const": true } } }, { "required": ["hidden"], "properties": { "hidden": { "const": true } } }]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "message"],
      "properties": {
        "check": { "$ref": "#/$defs/condition", "description": "Must be true, otherwise the start is blocked (error) or a warning is shown." },
        "message": { "$ref": "#/$defs/i18n" },
        "severity": { "enum": ["error", "warning"], "default": "error" }
      }
    },
    "workshop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings"],
      "properties": {
        "settings": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/settingKey" } },
        "collections": { "type": "boolean", "default": false },
        "appId": { "type": "integer", "minimum": 1, "description": "Workshop app id (default: steamAppId)." },
        "login": { "enum": ["anonymous", "host"], "default": "anonymous" },
        "dir": { "$ref": "#/$defs/relativePath", "description": "Item directory, default workshop/<itemId>." }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides of the derived panel flags (SPEC §8).",
      "properties": {
        "showMap": { "type": "boolean" },
        "showPlayerCount": { "type": "boolean" },
        "steamConnect": { "type": "boolean" },
        "consoleCommands": { "type": "boolean" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minCpuThreads": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 },
        "minRam": { "type": "integer", "minimum": 128, "maximum": 262144, "description": "MB" },
        "minDiskspace": { "type": "integer", "minimum": 1, "maximum": 4096, "description": "GB" }
      }
    }
  }
}
